---
import '../styles/global.css';

const title = 'Rimehand — One robot. Any game.';
const description =
	'Rimehand explores one generalist robot that can see, reason, and play across board games.';
const site = Astro.site ?? new URL('https://rimehand.snowballsh.com');
const canonicalUrl = new URL(Astro.url.pathname, site);
const socialImageUrl = new URL('/og.png', site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f7f9fc" />

		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rimehand" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Rimehand — One robot. Any game." />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />

		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink antialiased">
		<div class="page-shell relative isolate min-h-screen overflow-hidden">
			<header
				class="relative z-20 mx-auto w-full max-w-7xl px-5 pt-5 sm:px-8 lg:px-12"
			>
				<nav
					class="flex h-16 items-center justify-between rounded-full border border-line/80 bg-white/80 px-3 shadow-[0_1px_2px_rgba(15,23,42,0.04)] backdrop-blur sm:px-4"
					aria-label="Primary navigation"
				>
					<a
						href="/"
						class="group flex items-center gap-3 rounded-full pr-3 text-base font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
					>
						<span
							class="brand-mark size-10 shrink-0 overflow-hidden rounded-full border border-line bg-white transition-transform duration-200 group-hover:scale-103"
							aria-hidden="true"
						>
						</span>
						<span>Rimehand</span>
					</a>

					<a
						href="https://github.com/SnowballSH/Avalanche"
						class="inline-flex min-h-10 items-center gap-2 rounded-full bg-ink px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
						aria-label="View Avalanche on GitHub"
					>
						<svg
							viewBox="0 0 16 16"
							class="size-4 shrink-0 fill-current"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
							></path>
						</svg>
						Avalanche
					</a>
				</nav>
			</header>

			<main>
				<section
					class="relative z-10 mx-auto grid w-full max-w-7xl items-center gap-14 px-5 pt-20 pb-24 sm:px-8 sm:pt-24 lg:grid-cols-[minmax(0,1.06fr)_minmax(380px,0.94fr)] lg:gap-20 lg:px-12 lg:pt-28 lg:pb-32"
				>
					<div class="max-w-3xl">
						<h1
							class="max-w-4xl text-[clamp(3.6rem,9vw,7.25rem)] leading-[0.88] font-semibold tracking-[-0.065em] text-balance"
						>
							One robot.<br />
							<span class="text-accent">Any game.</span>
						</h1>

						<p
							class="mt-8 max-w-2xl text-lg leading-8 text-pretty text-muted sm:text-xl sm:leading-9"
						>
							Rimehand is an exploration into a generalist board-game-playing
							robot—one system designed to see, reason, and play across the
							table.
						</p>

						<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
							<a
								href="https://github.com/SnowballSH/Avalanche"
								class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-6 py-3 text-base font-medium text-white shadow-[0_8px_24px_rgba(37,99,235,0.2)] transition-all hover:-translate-y-0.5 hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
							>
								Explore Avalanche
							</a>
							<a
								href="mailto:yinuo@snowballsh.com"
								class="inline-flex min-h-12 items-center justify-center rounded-full border border-line bg-white px-6 py-3 text-base font-medium text-ink transition-colors hover:border-blue-300 hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
							>
								Get in touch
							</a>
						</div>
					</div>

					<div class="relative mx-auto w-full max-w-xl lg:max-w-none">
						<div
							class="visual-grid relative aspect-square overflow-hidden rounded-[2.25rem] border border-line bg-white p-6 shadow-[0_32px_80px_rgba(24,50,92,0.12)] sm:p-9"
						>
							<div
								class="absolute inset-[12%] rounded-full bg-blue-100 blur-3xl"
								aria-hidden="true"
							>
							</div>
							<div
								class="relative grid size-full place-items-center overflow-hidden rounded-[1.65rem] border border-white bg-white/70 backdrop-blur-sm"
							>
								<img
									src="/rimehand-mark.png"
									alt="Rimehand artwork showing a horse and elephant above circuit traces"
									width="512"
									height="512"
									fetchpriority="high"
									class="h-[88%] w-[88%] object-contain drop-shadow-[0_18px_28px_rgba(15,23,42,0.12)]"
								/>
							</div>
						</div>
					</div>
				</section>

				<section
					class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-16 sm:px-8 lg:px-12 lg:pb-20"
					aria-label="Rimehand products"
				>
					<div class="grid gap-5 md:grid-cols-2">
						<article
							class="flex min-h-72 flex-col justify-between rounded-4xl border border-line bg-panel px-6 py-8 sm:px-9 sm:py-10 lg:px-10"
						>
							<div>
								<p
									class="text-sm font-medium tracking-[0.12em] text-accent uppercase"
								>
									Open-source foundation
								</p>
								<h2
									class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl"
								>
									Avalanche
								</h2>
								<p
									class="mt-5 max-w-xl text-base leading-7 text-muted sm:text-lg sm:leading-8"
								>
									Our open-source chess engine is the first move: a focused
									engine beneath a broader ambition to build one capable player
									for many games.
								</p>
							</div>
							<a
								href="https://github.com/SnowballSH/Avalanche"
								class="mt-8 w-fit rounded-sm font-medium text-accent underline decoration-blue-200 decoration-2 underline-offset-4 transition-colors hover:text-accent-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
							>
								View Avalanche on GitHub
							</a>
						</article>

						<article
							class="min-h-72 rounded-4xl border border-line bg-white px-6 py-8 sm:px-9 sm:py-10 lg:px-10"
						>
							<h2
								class="max-w-md text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl"
							>
								More products coming soon.
							</h2>
							<p
								class="mt-5 max-w-lg text-base leading-7 text-muted sm:text-lg sm:leading-8"
							>
								Rimehand is still taking shape. We’re building toward a broader
								family of tools for generalist game playing.
							</p>
						</article>
					</div>
				</section>
			</main>

			<footer
				class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-8 sm:px-8 lg:px-12"
			>
				<div
					class="flex flex-col gap-4 border-t border-line py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
				>
					<p>© {new Date().getFullYear()} Rimehand</p>
					<a
						href="mailto:yinuo@snowballsh.com"
						class="w-fit rounded-sm transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
					>
						yinuo@snowballsh.com
					</a>
				</div>
			</footer>
		</div>
	</body>
</html>
